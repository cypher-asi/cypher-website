# Copy to `.env.local` and fill in. Never commit real keys.

# OpenSea API v2 key — powers the Wilder World Market page (/market), which
# browses live onchain NFTs and metadata. Get one at
# https://docs.opensea.io/reference/api-keys. Read server-side only; if unset,
# the Market page renders a graceful empty state.
OPENSEA_API_KEY=

# ZERO / zos-api auth. Powers Wilder World sign-in and account creation via the
# global login/create modal (used by the Market header and the vehicles store).
# ZOS_API_URL is the server-side base for the /api/auth routes (login, OTP,
# register, session), so auth fails if it is unset. NEXT_PUBLIC_ZOS_API_URL is the
# same base exposed to the client for the Epic Games OAuth redirect (public, not a
# secret). ZOS_INVITE_SLUG is applied server-side on account creation so signup is
# open without the user entering a code. zos-api requires a valid slug to create an
# account, so creation fails if it is unset.
ZOS_API_URL=
NEXT_PUBLIC_ZOS_API_URL=
ZOS_INVITE_SLUG=

# Vehicles funnel launch gate. Until this is exactly "true", the whole /vehicles
# section (store, detail, checkout) renders a coming-soon teaser, so the unfinished
# purchase flow is never publicly usable. Set per environment (e.g. "true" on
# staging to run the end-to-end while prod stays gated), then flip prod to go live.
# Server-side only, read at build time.
VEHICLES_LIVE=

# Vehicle card checkout (/api/vehicles/checkout). Charges the card via Stripe and
# delivers the NFT via ww-tx-server, mirroring the packs flow. STRIPE_SECRET_KEY is
# the shared zero.tech Stripe account secret (server-side only). WW_TX_SERVER_URL is
# the mint executor base URL. VEHICLE_ADMIN_SALE_API_KEY is the shared secret sent to
# ww-tx-server's vehicle-admin-sale endpoint, and MUST match the value set on
# ww-tx-server. NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is the client key for Stripe Elements.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
WW_TX_SERVER_URL=
VEHICLE_ADMIN_SALE_API_KEY=

# Zode shared-password gate (only enforced when AUTH_DISABLED is false in
# src/sites/zode/lib/session-constants.ts). SITE_PASSWORD is the shared
# password checked at /login; SESSION_SECRET signs the session cookie.
SITE_PASSWORD=
SESSION_SECRET=

# Indexer API — primary market data source for the Market page (/market).
# Base URL of the indexing service plus its `x-api-key` value. Read
# server-side only; if either is unset, indexer-backed data renders a
# graceful empty state.
INDEXER_API_URL=
INDEXER_API_KEY=

# ZODE compute-lead webhook — where /buy-compute and /give-compute submissions
# are forwarded (the CRM funnel). Any endpoint that accepts a JSON POST works:
# a Zapier/Make/n8n catch hook, a Slack incoming webhook, HubSpot forms, etc.
# Server-side only. If unset, the API returns 503 and the forms fall back to a
# pre-filled mailto so leads are never silently lost — but set this in prod so
# leads actually land in the CRM.
ZODE_LEADS_WEBHOOK_URL=

# Mixpanel — one public project token per brand site, so each domain reports to
# its own project and never cross-counts. Client-side (NEXT_PUBLIC_*); a site
# with no token set is a silent no-op. The active site's token is selected by
# domain at runtime (see src/features/analytics/mixpanel.ts).
NEXT_PUBLIC_MIXPANEL_TOKEN_CYPHER=
NEXT_PUBLIC_MIXPANEL_TOKEN_WILDERWORLD=
NEXT_PUBLIC_MIXPANEL_TOKEN_ZERO=
NEXT_PUBLIC_MIXPANEL_TOKEN_ZCHAIN=
NEXT_PUBLIC_MIXPANEL_TOKEN_ZODE=
